# Settings for scripts/release-android.sh and scripts/release-desktop.sh.
#
# Copy this file to scripts/release.env (ignored by git) and fill it in, or export the variables instead. Keep the
# NAME="${NAME:-value}" form: a variable already set in the environment then wins over the file.

# ---------------------------------------------------------------------------------------------------------------------
# The official site: the one place the release scripts take it from. Downloads, the app's update feed and the install
# script are served from here. (The apps' built-in defaults are separate: OFFICIAL_SITE in
# crates/reins-proto/src/lib.rs, reins.site in android/gradle.properties, DEFAULT_SITE in scripts/install.sh.)
REINS_SITE="${REINS_SITE:-https://reins2fa.com}"
# The server the Android release build's sign-in screen is filled in with. Unset: reins.defaultServer in
# android/gradle.properties (the hosted server, https://app.reins2fa.com).
# REINS_SERVER="${REINS_SERVER:-}"
# ---------------------------------------------------------------------------------------------------------------------

# Upload target (required; the values below are the hosted site's): an SSH destination and the directory the site
# serves as /releases. The hosted site also serves /install.sh, /install.ps1 and /reins.apk from it, and /models
# from /srv/reins-models.
REINS_RELEASE_SSH="${REINS_RELEASE_SSH:-reins}"       # an ~/.ssh/config host, or user@host
REINS_RELEASE_DIR="${REINS_RELEASE_DIR:-/srv/reins-releases}"

# Desktop (release-desktop.sh)
# The key that signs release manifests (required). Make one with:
#   cargo run -p reins-desktop --bin reins-release -- keygen <file>
REINS_RELEASE_KEY="${REINS_RELEASE_KEY:-}"            # e.g. $HOME/.config/reins-release/release-signing.pk8
# REINS_RELEASE_URL="${REINS_RELEASE_URL:-}"          # default: $REINS_SITE/releases
# REINS_RELEASE_KEEP="${REINS_RELEASE_KEEP:-10}"      # builds kept on the server per platform

# Android (release-android.sh)
# Optional additional SHA-1 check. The published certificate SHA-256 is pinned in android/release-signing.sha256.
# Phones only accept updates signed with the same certificate as the installed app.
REINS_ANDROID_CERT_SHA1="${REINS_ANDROID_CERT_SHA1:-}"   # lowercase hex, no colons
# REINS_ANDROID_KEYSTORE="${REINS_ANDROID_KEYSTORE:-}"    # default: $HOME/.android/debug.keystore
# REINS_ANDROID_KEYSTORE_PASS="${REINS_ANDROID_KEYSTORE_PASS:-}"  # default: android
# REINS_RELEASE_KEEP="${REINS_RELEASE_KEEP:-5}"       # APKs kept on the server
