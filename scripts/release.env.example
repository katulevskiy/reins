# Settings for scripts/release-android.sh and scripts/release-desktop.sh.
#
# Copy this file to scripts/release.env (ignored by git) and fill it in, or export the variables instead. Keep the
# NAME="${NAME:-value}" form: a variable already set in the environment then wins over the file.

# ---------------------------------------------------------------------------------------------------------------------
# The official site: the one place the release scripts take it from. Downloads, the app's update feed and the install
# script are served from here; the Android release build also uses it as the sign-in screen's default server.
# (The apps' built-in defaults are separate: OFFICIAL_SITE in crates/rewarden-proto/src/lib.rs, rewarden.site in
# android/gradle.properties, DEFAULT_SITE in scripts/install.sh.)
REWARDEN_SITE="${REWARDEN_SITE:-https://rewarden.arc-chat.com}"
# ---------------------------------------------------------------------------------------------------------------------

# Upload target (required): an SSH destination and the directory the site serves as /releases.
REWARDEN_RELEASE_SSH="${REWARDEN_RELEASE_SSH:-}"            # e.g. deploy@releases.example.com
REWARDEN_RELEASE_DIR="${REWARDEN_RELEASE_DIR:-}"            # e.g. /var/www/rewarden-releases

# Desktop (release-desktop.sh)
# The key that signs release manifests (required). Make one with:
#   cargo run -p rewarden-desktop --bin rewarden-release -- keygen <file>
REWARDEN_RELEASE_KEY="${REWARDEN_RELEASE_KEY:-}"            # e.g. $HOME/.config/rewarden-release/release-signing.pk8
# REWARDEN_RELEASE_URL="${REWARDEN_RELEASE_URL:-}"          # default: $REWARDEN_SITE/releases
# REWARDEN_RELEASE_KEEP="${REWARDEN_RELEASE_KEEP:-10}"      # builds kept on the server per platform

# Android (release-android.sh)
# The SHA-1 of the certificate every release must be signed with (required), so a wrong key never ships. Phones only
# accept updates signed with the same certificate as the installed app.
REWARDEN_ANDROID_CERT_SHA1="${REWARDEN_ANDROID_CERT_SHA1:-}"   # lowercase hex, no colons
# REWARDEN_ANDROID_KEYSTORE="${REWARDEN_ANDROID_KEYSTORE:-}"    # default: $HOME/.android/debug.keystore
# REWARDEN_ANDROID_KEYSTORE_PASS="${REWARDEN_ANDROID_KEYSTORE_PASS:-}"  # default: android
# REWARDEN_RELEASE_KEEP="${REWARDEN_RELEASE_KEEP:-5}"       # APKs kept on the server
